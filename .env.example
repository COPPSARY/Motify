# ------------------------------------------------------------------------------
# Motionly Environment Configuration
# ------------------------------------------------------------------------------

# Optional cloud collaboration backend URL:
VITE_MOTIONLY_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# PostHog product analytics (US Cloud)
# ------------------------------------------------------------------------------
# The project token is write-only and safe to expose to the browser.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keep local development traffic out of production analytics by default.
VITE_PUBLIC_POSTHOG_CAPTURE_DEV=false
