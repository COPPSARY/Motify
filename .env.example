# ------------------------------------------------------------------------------
# Motify Environment Configuration
# ------------------------------------------------------------------------------

# Cloud collaboration backend origin. The browser uses its own origin if omitted.
# Set this in .env for a separate backend; Vite exposes VITE_* values to browsers.
VITE_MOTIFY_API_URL=http://localhost:3000

# Server-side origin for the same API. The AI endpoint verifies the caller's
# Motify session against it before spending provider budget, so generation
# requires a signed-in account. Leave it unset only for a self-hosted editor
# that runs on its own provider key with no accounts.
MOTIFY_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AI provider: gemini or openai-compatible
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

OPENAI_COMPATIBLE_API_KEY=
# Required when AI_PROVIDER=openai-compatible.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Output ceiling for one generation. A film is emitted as a single JSON object
# carrying the whole composition, so a rich one is a large response; when the
# budget runs out mid-write the generation is rejected rather than salvaged
# half-finished. Raise this before blaming the model for unfinished films.
# Defaults: 65536 (gemini), 32768 (openai-compatible).
AI_MAX_OUTPUT_TOKENS=

# ------------------------------------------------------------------------------
# PostHog product analytics (US Cloud)
# ------------------------------------------------------------------------------
# The project token is write-only and safe to expose to the browser.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keep local development traffic out of production analytics by default.
VITE_PUBLIC_POSTHOG_CAPTURE_DEV=false
