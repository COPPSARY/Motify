{
  "name": "@coppsary/motify",
  "version": "2.1.0",
  "description": "A code-first motion graphics tool for creating, previewing, and exporting professional animations.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "motify": "bin/motionly.js",
    "motionly": "bin/motionly.js"
  },
  "files": [
    "dist",
    "bin",
    ".agents/skills/write-motionly",
    ".agents/skills/scene-design",
    "docs",
    "examples",
    "registry",
    "templates",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run prompt:build && vite",
    "build": "npm run prompt:build && node scripts/build-registry-source.mjs && tsc && vite build",
    "prompt:build": "node scripts/build-ai-prompt.mjs",
    "prompt:check": "node scripts/build-ai-prompt.mjs --check",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa:editor": "node qa/editor-browser-qa.mjs",
    "qa:timeline": "node qa/timeline-editor-qa.mjs",
    "registry:build-manifest": "node scripts/build-registry-manifest.mjs",
    "render:video": "node scripts/render-video.mjs",
    "lint": "eslint src tests examples templates --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,svelte,css}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"templates/**/*.ts\" \"qa/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,svelte,css}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"templates/**/*.ts\" \"qa/**/*.mjs\"",
    "prepare": "husky",
    "registry:build-source": "node scripts/build-registry-source.mjs",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "npm run type-check && npm run build && npm run test:run && npm run package:check",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "gsap": "^3.15.0",
    "lucide-svelte": "^1.0.1",
    "mp4-muxer": "^5.2.2",
    "posthog-js": "^1.427.3",
    "svelte": "^5.56.4",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "puppeteer-core": "^25.9.0",
    "svelte-check": "^4.7.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COPPSARY/Motify.git"
  },
  "homepage": "https://github.com/COPPSARY/Motify#readme",
  "publishConfig": {
    "access": "public"
  }
}
